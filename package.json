{
	"name": "@lesjoursfr/audio-waveform",
	"version": "4.2.0",
	"description": "A library to generate waveform for audio files.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/audio-waveform.git"
	},
	"homepage": "https://github.com/lesjoursfr/audio-waveform#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/audio-waveform/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"waveform",
		"generator",
		"audio"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"check-lint": "eslint",
		"check-format": "prettier --check .",
		"check-tsc": "tsc --noEmit",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"build": "tsc && cp -R src/audio-analyzer lib",
		"test": "mocha"
	},
	"dependencies": {
		"electron": "^43.7.7",
		"mime-types": "^3.0.2",
		"uuid": "^14.0.2",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.6",
		"@types/mime-types": "3.0.1",
		"@types/mocha": "10.0.10",
		"@types/node": "24.19.0",
		"@types/yargs": "17.0.35",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.13.0",
		"mocha": "12.0.3",
		"prettier": "3.9.9",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	},
	"packageManager": "yarn@4.18.1"
}
